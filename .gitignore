# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Python environment
.venv/
__pycache__/
*.pyc

# Authentication database and local secrets
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.key

# FlightGuard local backups
/backups/
*.backup_*
*.backup
*.bak

# Local operational datasets and model artifacts
*.csv
*.parquet
*.pkl
*.joblib
*.onnx
*.pt
*.pth

# Python cache and environments
.pytest_cache/
.venv-ml/

# Publish small research evaluation tables, not raw datasets
!research_2025/results/
!research_2025/results/*.csv

# FlightGuard AI GitHub publishing exclusions

# Raw BTS archives are retained locally
/research_2025/data/raw/bts/*.zip

# Historical source-code backups
/backend/main_before_qwen25.py
/backend/main_before_research_2025_router.py
/backend/research_2025_delay_routes_before_auth.py
